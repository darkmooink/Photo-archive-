<%- include('partials/header', { title: title, inboxCount: inboxCount }) %>

<div class="page-header">
  <h1>Inbox <span class="badge badge-lg"><%= photos.length %></span></h1>
  <p class="text-muted">Photos awaiting review</p>
</div>

<% if (photos.length === 0) { %>
  <div class="empty-state">
    <p>🎉 No photos waiting for review!</p>
    <a href="/photos/upload" class="btn btn-primary">Upload Photos</a>
  </div>
<% } else { %>
  <div class="photo-grid">
    <% photos.forEach(function(photo) { %>
      <a href="/photos/<%= photo.id %>" class="photo-card">
        <div class="photo-thumb">
          <% if (photo.review_path) { %>
            <img src="/processed/<%= require('path').basename(photo.review_path) %>" alt="<%= photo.title || photo.filename %>">
          <% } else if (photo.clean_path) { %>
            <img src="/processed/<%= require('path').basename(photo.clean_path) %>" alt="<%= photo.title || photo.filename %>">
          <% } else { %>
            <img src="/uploads/<%= photo.filename %>" alt="<%= photo.title || photo.filename %>">
          <% } %>
        </div>
        <div class="photo-card-info">
          <p class="photo-title"><%= photo.title || photo.filename %></p>
          <% if (photo.date_taken) { %><p class="text-muted"><%= photo.date_taken %></p><% } %>
          <span class="status-badge status-<%= photo.status %>"><%= photo.status.replace('_', ' ') %></span>
        </div>
      </a>
    <% }) %>
  </div>
<% } %>

<%- include('partials/footer') %>
